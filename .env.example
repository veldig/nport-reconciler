# Local: `npm run db:local` starts an embedded Postgres (PGlite) on port 5433.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Production: a Neon or PlanetScale Postgres URL instead.

# SEC requires a descriptive User-Agent with contact info for EDGAR requests.
SEC_USER_AGENT="Your Name you@yourdomain.com"
